<%
  const b = booking || {};
  const isReadOnly = typeof readOnly !== 'undefined' && readOnly;
  const gdmDocs = typeof gdmDocuments !== 'undefined' ? gdmDocuments : [];
%>

<div class="page-header d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
  <div>
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb mb-2">
        <li class="breadcrumb-item"><a href="/bookings">Bookings</a></li>
        <li class="breadcrumb-item active"><%= b.bookingId || 'Parking Lot #' + b.id %></li>
      </ol>
    </nav>
    <div class="d-flex align-items-center gap-3 flex-wrap">
      <h1 class="page-title mb-0"><%= b.bookingId || 'Parking Lot Entry #' + b.id %></h1>
      <%- include('../partials/stage-badge', { stage: b.stage }) %>
    </div>
  </div>
  <div class="d-flex gap-2 flex-wrap">
    <% if (!isReadOnly) { %>
      <button type="submit" form="bookingDetailForm" class="btn btn-primary" id="saveBookingBtn">
        <i class="bi bi-check-lg me-1"></i> Save Changes
      </button>
      <a href="/bookings/<%= b.id %>/gdm/generate" class="btn btn-outline-success">
        <i class="bi bi-file-earmark-pdf me-1"></i> Generate GDM PDF
      </a>
      <% if (nextStages && nextStages.length) { %>
        <% nextStages.forEach(function(ns) { %>
          <button type="button" class="btn btn-primary stage-transition-btn"
                  data-stage="<%= ns.value %>" data-label="<%= ns.label %>">
            Move to <%= ns.label %>
          </button>
        <% }); %>
      <% } %>
    <% } else { %>
      <span class="badge bg-secondary-subtle text-secondary"><i class="bi bi-lock me-1"></i> Read Only</span>
    <% } %>
  </div>
</div>

<form id="bookingDetailForm" method="POST" action="/bookings/<%= b.id %>">
  <div class="row g-4">
    <div class="col-lg-8">
      <%- include('../partials/booking-sections', { booking: b, readOnly: isReadOnly, editable: !isReadOnly, isEdit: true }) %>

      <% if (gdmDocs.length) { %>
        <div class="card shadow-sm mt-4">
          <div class="card-header">
            <i class="bi bi-file-earmark-pdf me-2"></i> Generated GDMs
          </div>
          <div class="card-body p-0">
            <div class="table-responsive">
              <table class="table table-hover mb-0 align-middle">
                <thead class="table-light">
                  <tr>
                    <th>GDM Number</th>
                    <th>Generated Date</th>
                    <th>Generated By</th>
                    <th>Invoice Number</th>
                    <th>File</th>
                    <th class="text-end">Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% gdmDocs.forEach(function(doc) { %>
                    <tr>
                      <td class="fw-semibold"><%= doc.gdmNumber %></td>
                      <td><%= formatDateTime(doc.generatedAt) %></td>
                      <td><%= doc.generatedBy %></td>
                      <td><%= doc.invoiceNumber || '—' %></td>
                      <td class="small text-muted"><%= doc.driveFileName %></td>
                      <td class="text-end">
                        <a href="/bookings/<%= b.id %>/gdm/documents/<%= doc.id %>/view"
                           class="btn btn-sm btn-outline-primary" target="_blank" rel="noopener">
                          <i class="bi bi-eye"></i> View
                        </a>
                        <a href="/bookings/<%= b.id %>/gdm/documents/<%= doc.id %>/download"
                           class="btn btn-sm btn-outline-secondary">
                          <i class="bi bi-download"></i> Download
                        </a>
                      </td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      <% } %>
    </div>
    <div class="col-lg-4">
      <div class="card shadow-sm mb-4">
        <div class="card-header"><i class="bi bi-clock-history me-2"></i>Timeline</div>
        <div class="card-body timeline-body">
          <% if (timeline && timeline.length) { %>
            <div class="timeline">
              <% timeline.forEach(function(entry) { %>
                <div class="timeline-item">
                  <div class="timeline-marker"></div>
                  <div class="timeline-content">
                    <div class="timeline-title"><%= entry.actionDescription %></div>
                    <% if (entry.fieldName && entry.oldValue !== entry.newValue) { %>
                      <div class="timeline-change small text-muted">
                        <%= entry.oldValue || '—' %> → <%= entry.newValue || '—' %>
                      </div>
                    <% } %>
                    <div class="timeline-meta small text-muted">
                      <%= entry.changedBy %> · <%= formatDateTime(entry.timestamp) %>
                    </div>
                  </div>
                </div>
              <% }); %>
            </div>
          <% } else { %>
            <p class="text-muted mb-0">No history yet.</p>
          <% } %>
        </div>
      </div>
    </div>
  </div>

  <% if (!isReadOnly) { %>
    <div class="d-flex gap-2 mt-4 pb-4">
      <button type="submit" class="btn btn-primary btn-lg" id="saveBookingBtnBottom">
        <i class="bi bi-check-lg me-1"></i> Save Changes
      </button>
    </div>
  <% } %>
</form>

<% if (!isReadOnly) { %>
<!-- Transporter create modal -->
<div class="modal fade" id="transporterModal" tabindex="-1" aria-labelledby="transporterModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="transporterModalLabel">New Transporter</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div id="transporterModalError" class="alert alert-danger d-none" role="alert"></div>
        <div class="row g-3">
          <div class="col-md-6">
            <label class="form-label" for="newTransporterName">Name <span class="text-danger">*</span></label>
            <input type="text" class="form-control" id="newTransporterName" required>
          </div>
          <div class="col-md-6">
            <label class="form-label" for="newTransporterPhone">Phone Number</label>
            <input type="text" class="form-control" id="newTransporterPhone">
          </div>
          <div class="col-12">
            <label class="form-label" for="newTransporterAddress">Address</label>
            <textarea class="form-control" id="newTransporterAddress" rows="2"></textarea>
          </div>
          <div class="col-12">
            <label class="form-label" for="newTransporterRoutes">Operating Routes</label>
            <textarea class="form-control" id="newTransporterRoutes" rows="2" placeholder="e.g. Mumbai – Pune – Bangalore"></textarea>
          </div>
          <div class="col-md-4">
            <label class="form-label" for="newTransporterBank">Bank Name</label>
            <input type="text" class="form-control" id="newTransporterBank">
          </div>
          <div class="col-md-4">
            <label class="form-label" for="newTransporterAccount">Account Number</label>
            <input type="text" class="form-control" id="newTransporterAccount">
          </div>
          <div class="col-md-4">
            <label class="form-label" for="newTransporterIfsc">IFSC</label>
            <input type="text" class="form-control" id="newTransporterIfsc">
          </div>
          <div class="col-12">
            <label class="form-label" for="newTransporterNotes">Notes</label>
            <textarea class="form-control" id="newTransporterNotes" rows="2"></textarea>
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary" id="saveTransporterBtn">
          <i class="bi bi-check-lg me-1"></i> Save Transporter
        </button>
      </div>
    </div>
  </div>
</div>

<!-- Truck create modal -->
<div class="modal fade" id="truckModal" tabindex="-1" aria-labelledby="truckModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="truckModalLabel">New Truck</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div id="truckModalError" class="alert alert-danger d-none" role="alert"></div>
        <div class="row g-3">
          <div class="col-md-6">
            <label class="form-label" for="newTruckNumber">Truck Number <span class="text-danger">*</span></label>
            <input type="text" class="form-control" id="newTruckNumber" required>
          </div>
          <div class="col-md-6">
            <label class="form-label" for="newTruckCapacity">Capacity (Kgs/Tons) <span class="text-danger">*</span></label>
            <input type="number" step="0.01" min="0" class="form-control" id="newTruckCapacity" required>
          </div>
          <div class="col-12"><hr class="my-1"><small class="text-muted">Default Driver &amp; Owner (optional)</small></div>
          <div class="col-md-6">
            <label class="form-label" for="newTruckDriverName">Driver Name</label>
            <input type="text" class="form-control" id="newTruckDriverName">
          </div>
          <div class="col-md-6">
            <label class="form-label" for="newTruckDriverNumber">Driver Number</label>
            <input type="text" class="form-control" id="newTruckDriverNumber">
          </div>
          <div class="col-md-6">
            <label class="form-label" for="newTruckOwnerName">Owner Name</label>
            <input type="text" class="form-control" id="newTruckOwnerName">
          </div>
          <div class="col-md-6">
            <label class="form-label" for="newTruckOwnerNumber">Owner Number</label>
            <input type="text" class="form-control" id="newTruckOwnerNumber">
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary" id="saveTruckBtn">
          <i class="bi bi-check-lg me-1"></i> Save Truck
        </button>
      </div>
    </div>
  </div>
</div>
<% } %>

<div class="modal fade" id="stageModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <form id="stageForm" method="POST" action="/bookings/<%= b.id %>/stage">
        <div class="modal-header">
          <h5 class="modal-title">Confirm Stage Change</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <input type="hidden" name="stage" id="stageValue">
          <p>Move this booking to <strong id="stageLabel"></strong>?</p>
          <div class="mb-3">
            <label class="form-label">Remark (optional)</label>
            <textarea name="remark" class="form-control" rows="2"></textarea>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary">Confirm</button>
        </div>
      </form>
    </div>
  </div>
</div>

<% if (!isReadOnly) { %>
<script src="/js/autocomplete.js"></script>
<script src="/js/booking-form.js"></script>
<% } %>
<script src="/js/booking-detail.js"></script>
