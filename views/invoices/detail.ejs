<%
  const inv = invoice || {};
%>

<div class="page-header d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
  <div>
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb mb-2">
        <li class="breadcrumb-item"><a href="/invoices">Invoices</a></li>
        <li class="breadcrumb-item active"><%= inv.invoiceNumber %></li>
      </ol>
    </nav>
    <h1 class="page-title mb-0"><%= inv.invoiceNumber %></h1>
  </div>
</div>

<div class="row g-4">
  <div class="col-lg-8">
    <div class="card shadow-sm mb-4">
      <div class="card-header"><i class="bi bi-receipt me-2"></i>Invoice Information</div>
      <div class="card-body">
        <form method="POST" action="/invoices/<%= inv.id %>">
          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label">Invoice Number</label>
              <input type="text" name="invoiceNumber" class="form-control" value="<%= inv.invoiceNumber %>" required>
            </div>
            <div class="col-md-6">
              <label class="form-label">Created Date</label>
              <input type="text" class="form-control" value="<%= formatDateTime(inv.createdAt) %>" readonly>
            </div>
            <div class="col-md-6">
              <label class="form-label">Created By</label>
              <input type="text" class="form-control" value="<%= inv.createdBy || '—' %>" readonly>
            </div>
            <div class="col-12">
              <label class="form-label">Recipient Details</label>
              <textarea name="recipientDetails" class="form-control" rows="4" required><%= inv.recipientDetails || '' %></textarea>
            </div>
          </div>
          <div class="mt-3">
            <button type="submit" class="btn btn-primary">
              <i class="bi bi-check-lg me-1"></i> Save Changes
            </button>
          </div>
        </form>
      </div>
    </div>

    <div class="card shadow-sm">
      <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="bi bi-journal-text me-2"></i>Associated Bookings</span>
        <span class="badge bg-primary"><%= (inv.bookings && inv.bookings.length) || 0 %></span>
      </div>
      <div class="card-body p-0">
        <% if (inv.bookings && inv.bookings.length) { %>
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <thead>
                <tr>
                  <th>Booking ID</th>
                  <th>GDM</th>
                  <th>From</th>
                  <th>To</th>
                  <th>Transporter</th>
                  <th>Truck</th>
                  <th>Packages</th>
                  <th>Weight</th>
                  <th>Freight</th>
                </tr>
              </thead>
              <tbody>
                <% inv.bookings.forEach(function(b) { %>
                  <tr style="cursor:pointer" onclick="window.location='/bookings/<%= b.id %>'">
                    <td><a href="/bookings/<%= b.id %>" class="fw-semibold text-decoration-none" onclick="event.stopPropagation()"><%= b.bookingId || '#' + b.id %></a></td>
                    <td><%= b.gdmNumber || '—' %></td>
                    <td><%= b.fromLocationName || '—' %></td>
                    <td><%= b.toLocationName || '—' %></td>
                    <td><%= b.transporterName || '—' %></td>
                    <td><%= b.truckNumber || '—' %></td>
                    <td><%= b.totalPackages ?? '—' %></td>
                    <td><%= b.totalWeight != null ? Number(b.totalWeight).toLocaleString('en-IN') + ' kg' : '—' %></td>
                    <td><%= b.totalCompanyFreight != null ? '₹' + Number(b.totalCompanyFreight).toLocaleString('en-IN') : '—' %></td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div class="p-4 text-center text-muted">No bookings linked to this invoice.</div>
        <% } %>
      </div>
    </div>
  </div>

  <div class="col-lg-4">
    <div class="card shadow-sm">
      <div class="card-header"><i class="bi bi-bar-chart me-2"></i>Summary</div>
      <div class="card-body">
        <dl class="row mb-0">
          <dt class="col-7">Bookings</dt>
          <dd class="col-5 text-end"><%= inv.bookingCount ?? (inv.bookings ? inv.bookings.length : 0) %></dd>
          <dt class="col-7">Total Packages</dt>
          <dd class="col-5 text-end"><%= inv.totalPackages ?? 0 %></dd>
          <dt class="col-7">Total Weight</dt>
          <dd class="col-5 text-end"><%= inv.totalWeight != null ? Number(inv.totalWeight).toLocaleString('en-IN') + ' kg' : '0' %></dd>
          <dt class="col-7">Total Freight</dt>
          <dd class="col-5 text-end fw-semibold"><%= inv.totalFreight != null ? '₹' + Number(inv.totalFreight).toLocaleString('en-IN') : '₹0' %></dd>
        </dl>
      </div>
    </div>
  </div>
</div>
