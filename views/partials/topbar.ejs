<header class="topbar">
  <button class="btn btn-link sidebar-toggle d-lg-none" id="sidebarToggle">
    <i class="bi bi-list fs-4"></i>
  </button>
  <div class="topbar-title d-none d-md-block">
    <%- typeof pageTitle !== 'undefined' ? pageTitle : title %>
  </div>
  <div class="topbar-actions ms-auto d-flex align-items-center gap-3">
    <span class="text-muted small d-none d-sm-inline">
      <i class="bi bi-person-circle"></i> <%= user.fullName || user.email %>
      <span class="badge bg-primary-subtle text-primary ms-1"><%= user.role %></span>
    </span>
    <form action="/logout" method="POST" class="m-0">
      <button type="submit" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-box-arrow-right"></i> Logout
      </button>
    </form>
  </div>
</header>
