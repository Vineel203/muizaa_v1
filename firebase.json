{
  "hosting": {
    "public": "public",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {
        "source": "/css/**",
        "destination": "/css/**"
      },
      {
        "source": "/js/**",
        "destination": "/js/**"
      },
      {
        "source": "/images/**",
        "destination": "/images/**"
      },
      {
        "source": "**",
        "function": {
          "functionId": "api",
          "region": "asia-south1"
        }
      }
    ]
  },
  "functions": [
    {
      "source": ".",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "runtime": "nodejs20"
    }
  ]
}
