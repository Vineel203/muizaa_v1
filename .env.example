NODE_ENV=development
PORT=3000

# PostgreSQL (Firebase SQL / Cloud SQL)
DATABASE_URL=postgresql://user:password@host:5432/muizaa
# false for local/non-SSL servers; true for Cloud SQL with SSL
DB_SSL=false
DB_POOL_MAX=10

# Production only (App Hosting): Cloud SQL instance connection name
# CLOUD_SQL_INSTANCE=muizaa:us-east4:YOUR_INSTANCE_NAME

# Session
SESSION_SECRET=change-this-to-a-long-random-string-in-production
SESSION_NAME=muizaa.sid
SESSION_MAX_AGE_MS=86400000
SESSION_REMEMBER_MAX_AGE_MS=2592000000

# App
APP_NAME=Muizaa Logistics
APP_URL=http://localhost:3000
