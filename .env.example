NODE_ENV=development
PORT=3000

# PostgreSQL — local or Cloud SQL (encode ! in password as %21)
DATABASE_URL=postgresql://user:password@localhost:5432/muizaa
DB_SSL=false
DB_POOL_MAX=10

# Cloud SQL from your PC (migrate / db:fresh) — requires: gcloud auth application-default login
# Omit these when using localhost or Cloud SQL public IP with your IP whitelisted.
# CLOUD_SQL_INSTANCE=muizaa:asia-south1:muizaa-instance
# CLOUD_SQL_USE_CONNECTOR=true

# Session
SESSION_SECRET=change-this-to-a-long-random-string-in-production
SESSION_NAME=muizaa.sid
SESSION_MAX_AGE_MS=86400000
SESSION_REMEMBER_MAX_AGE_MS=2592000000

# Seed (npm run seed / db:fresh)
# ADMIN_EMAIL=admin@muizaa.com
# ADMIN_PASSWORD=Admin@123
# ADMIN_NAME=System Admin

# App
APP_NAME=Muizaa Logistics
APP_URL=http://localhost:3000

# Google Drive (GDM PDF storage)
# GOOGLE_DRIVE_ROOT_FOLDER_ID=your-root-folder-id
# GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# GOOGLE_DRIVE_USE_LOCAL_FALLBACK=true

# PDF generation (optional — uses Puppeteer Chrome or system Chrome)
# PUPPETEER_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# PUPPETEER_CACHE_DIR=C:\Users\you\.cache\puppeteer

# Production PDF via Gotenberg (Cloud Run) — set after: npm run deploy:gotenberg
# GOTENBERG_URL=https://muizaa-gotenberg-xxxxx.us-east4.run.app
# GOTENBERG_USE_IAM=true
